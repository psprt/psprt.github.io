{
  "log": {
    "level": "warn"
  },
  "http_clients": [
    {
      "tag": "proxy",
      "detour": "Proxy"
    }
  ],
  "inbounds": [
    {
      "type": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "urltest",
      "tag": "Proxy",
      "outbounds": [
        "Singapore 01",
        "Singapore 02"
      ]
    },
    {
      "type": "tuic",
      "tag": "Singapore 01",
      "server": "",
      "server_port": 443,
      "uuid": "",
      "password": "",
      "tls": {
        "enabled": true,
        "server_name": "",
        "insecure": true,
        "alpn": "h3"
      }
    },
    {
      "type": "tuic",
      "tag": "Singapore 02",
      "server": "",
      "server_port": 443,
      "uuid": "",
      "password": "",
      "tls": {
        "enabled": true,
        "server_name": "",
        "insecure": true,
        "alpn": "h3"
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "domain_suffix": "gokuai.com",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ],
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-cn",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs"
      }
    ]
  }
}